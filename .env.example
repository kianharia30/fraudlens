# Copy to .env and adjust. No secrets are required to run FraudLens.

# Alternative config file (defaults to configs/config.yaml).
# configs/config.synthetic.yaml points every path at synthetic smoke-test data.
FRAUDLENS_CONFIG=configs/config.yaml

# DEBUG | INFO | WARNING | ERROR
FRAUDLENS_LOG_LEVEL=INFO

# Only needed for `make download-data` (Kaggle CLI). Create at kaggle.com > Settings > API.
# Prefer ~/.kaggle/kaggle.json (chmod 600) over putting the key here.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
